# Per-install configuration and runtime files (never commit: database password, keys)
wp-config.php
.htaccess
wp-content/uploads/
wp-content/upgrade/
wp-content/upgrade-temp-backup/
wp-content/cache/
wp-content/backup*/
wp-content/debug.log
/wp-content/*.log

# Kept on this computer only (not part of the WordPress site).
# The static HTML site is in git history: tag static-html-v4.
# The leading "/" matters: without it "dist/" would also hide WordPress's own
# wp-includes/css/dist and wp-includes/js/dist (the admin and editor styles/scripts).
/html-backup/
/design-data/
/dist/

# Local tooling
/.claude/
/node_modules/

